# Postgres connection string (Vercel / Neon sets this automatically).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional: the first admin login. If these are not set, the first login is admin / admin123.
# (Kept from the first version so the existing password keeps working.)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
