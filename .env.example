DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

ADMIN_USERNAME="admin"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10).replace(/\$/g, '\\\\$'))"
# IMPORTANT: Next.js expands $VAR patterns in .env files, so every literal "$" in the
# bcrypt hash must be escaped as "\$" (the command above does this for you).
ADMIN_PASSWORD_HASH="\$2a\$10\$replace-with-a-real-bcrypt-hash"
